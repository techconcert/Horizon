rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anonymous sync backups indexed by unique recovery sync code
    match /sync_backups/{syncCode} {
      allow read: if true;
      allow write: if syncCode.matches('^HZ-[A-Z0-9]{4}$')
                   && request.resource.data.syncCode == syncCode;
    }

    // Administrative backup archives (accessible only via server-side admin API)
    match /sync_archives/{syncCode} {
      allow read, write: if false;
    }
  }
}
